# CI render scenario: every optional feature on (dummy values only)
APP_HOST=ci.example.com
ADMIN_PASSWORD=ci-admin
REDIS_PASSWORD=ci-redis
PGSQL_PASSWORD=ci-pg
DEEPWIKI_PLUGIN_ENABLED=true
IMAGEGEN_PLUGIN_ENABLED=true
INVENTORY_PLUGIN_ENABLED=true
INTERNAL_OTPL_ENABLED=true
TOOLS_ENABLED=true
SELF_HTTPS=true
PROXY_ENABLED=true
PROXY_ENABLED_HTTP=http://proxy.example.com:3128
PROXY_ENABLED_HTTPS=http://proxy.example.com:3128
PROXY_ENABLED_NO_PROXY=localhost
CA_ENABLED=true
SSO_ENABLED=true
SSO_MODE=oidc
OIDC_AUTHORIZATION_ENDPOINT=https://idp.example.com/authorize
OIDC_CLIENT_ID=ci-client
OIDC_CLIENT_SECRET=ci-secret
OIDC_TOKEN_ENDPOINT=https://idp.example.com/token
OIDC_USERINFO_ENDPOINT=https://idp.example.com/userinfo
OIDC_METADATA_ENDPOINT=https://idp.example.com/.well-known/openid-configuration
OIDC_END_SESSION_ENDPOINT=https://idp.example.com/logout
EXTERNAL_PGSQL_SVC_ENABLED=true
PGSQL_HOST=pg.example.com
EXTERNAL_REDIS_SVC_ENABLED=true
REDIS_HOST=redis.example.com
REDIS_SSL=true
GRAFANA_MCP_ENABLED=true
GRAFANA_URL=https://grafana.example.com
GRAFANA_SERVICE_ACCOUNT_TOKEN=ci-token
ADO_MCP_ENABLED=true
ADO_MCP_ORGANIZATION=ci-org
ADO_MCP_PERSONAL_ACCESS_TOKEN=Og==
ADO_MCP_API_KEY=ci-key
